const fs = require("fs/promises")

const caminho = () => process.env.ARQUIVO_ENCOMENDAS || "encomendas.json"

async function listar() {
      try {
            return JSON.parse(await fs.readFile(caminho(), "utf-8"))
      } catch (e) {
            if (e.code === "ENOENT") return []
                throw e
      }
}

const gravar = (lista) =>
  fs.writeFile(caminho(), JSON.stringify(lista, null, 2))

  async function salvar(encomenda) {
      const lista = await listar()
        const id =
            encomenda.id ?? lista.reduce((m, e) => Math.max(m, e.id), 0) + 1
              const registro = { ...encomenda, id }
                lista.push(registro)
                  await gravar(lista)
                    return registro
  }

  async function atualizar(id, dados) {
      const lista = await listar();
        const i = lista.findIndex((e) => e.id === Number(id))
          if (i === -1) return null
            lista[i] = { ...lista[i], ...dados, id: lista[i].id }
              await gravar(lista)
                return lista[i]
  }

  async function remover(id) {
      const lista = await listar();
        const nova = lista.filter((e) => e.id !== Number(id))
          if (nova.length === lista.length) return false
            await gravar(nova)
              return true
  }

  module.exports = { listar, salvar, atualizar, remover }
      }
}